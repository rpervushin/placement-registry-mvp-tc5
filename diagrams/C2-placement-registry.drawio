<mxfile host="app.diagrams.net">
  <diagram id="c2-placement-registry" name="C2 - Placement Registry">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= ПОЛЬЗОВАТЕЛИ ================= -->
        <mxCell id="admin" value="&lt;b&gt;Администратор реестра&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Команда Каталог. Просматривает и&lt;br&gt;правит конфигурацию плейсментов" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#2E75B6;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="owner" value="&lt;b&gt;Владелец полки&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;X5 Media / Trade-Promo / Лояльность.&lt;br&gt;Этап 2 — доступ к своим плейсментам" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#2E75B6;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- ================= ГРАНИЦА РЕШЕНИЯ ================= -->
        <mxCell id="boundary" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeColor=#70AD47;fillColor=none;verticalAlign=bottom;align=left;spacingLeft=14;spacingBottom=10;fontStyle=1;fontSize=12;fontColor=#375623;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="560" height="700" as="geometry" />
        </mxCell>
        <mxCell id="boundary-label" value="&lt;b&gt;Placement Registry&lt;/b&gt;&lt;br&gt;[Service]" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#375623;" vertex="1" parent="1">
          <mxGeometry x="350" y="710" width="220" height="40" as="geometry" />
        </mxCell>

        <!-- ================= КОНТЕЙНЕРЫ РЕЕСТРА (НОВЫЕ) ================= -->
        <mxCell id="adminui" value="&lt;b&gt;Admin UI&lt;/b&gt;&lt;br&gt;[Компонент: React]&lt;br&gt;&lt;br&gt;Просмотр/правка конфигурации,&lt;br&gt;карта плейсментов, метрики из Grafana" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#29ABE2;strokeColor=#70AD47;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="380" y="90" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="api" value="&lt;b&gt;Registry API&lt;/b&gt;&lt;br&gt;[Система: Python 3.11 / FastAPI]&lt;br&gt;&lt;br&gt;admin-роутер (Read+Update) +&lt;br&gt;internal-роутер приёма push от RecSys/Catalog" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=#70AD47;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="380" y="250" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="worker" value="&lt;b&gt;Sync worker&lt;/b&gt;&lt;br&gt;[Система: Python / arq]&lt;br&gt;&lt;br&gt;Этап 2: опрос AB-платформы&lt;br&gt;(на MVP не разворачивается)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=#70AD47;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="420" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;[Модуль/данные: RDBMS]&lt;br&gt;&lt;br&gt;Конфигурация плейсментов,&lt;br&gt;audit log" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#9DC3E6;strokeColor=#70AD47;strokeWidth=2;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="680" y="250" width="180" height="120" as="geometry" />
        </mxCell>

        <mxCell id="redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;[Модуль/данные: KVDB, cashews]&lt;br&gt;&lt;br&gt;Кэш для Admin UI (опц.)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#9DC3E6;strokeColor=#70AD47;strokeWidth=2;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="680" y="90" width="180" height="110" as="geometry" />
        </mxCell>

        <!-- ================= ВНЕШНИЕ СИСТЕМЫ (СУЩЕСТВУЮЩИЕ) ================= -->
        <mxCell id="recsys" value="&lt;b&gt;RecSys (PA Api)&lt;/b&gt;&lt;br&gt;[Внешняя система: MS, Go]&lt;br&gt;&lt;br&gt;Персонализированные рекомендации&lt;br&gt;и ранжирование плейсментов" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#808080;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1040" y="40" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="catalog" value="&lt;b&gt;MS Catalog&lt;/b&gt;&lt;br&gt;[Внешняя система: MS, Python]&lt;br&gt;&lt;br&gt;Каталог товаров; на MVP — опц.&lt;br&gt;мониторинг, Этап 2 — push плейсментов" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#808080;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1040" y="170" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="grafana" value="&lt;b&gt;Grafana / Prometheus&lt;/b&gt;&lt;br&gt;[Внешняя система: Monitoring]&lt;br&gt;&lt;br&gt;Метрики ручки /context Каталога&lt;br&gt;по label placement_id" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#808080;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1040" y="310" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="ab" value="&lt;b&gt;AB-платформа&lt;/b&gt;&lt;br&gt;[Внешняя система: MS]&lt;br&gt;&lt;br&gt;Результаты A/B-тестов по&lt;br&gt;плейсментам — Этап 2" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#808080;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1040" y="440" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="x5id" value="&lt;b&gt;X5ID&lt;/b&gt;&lt;br&gt;[Внешняя система: Auth]&lt;br&gt;&lt;br&gt;Корпоративная аутентификация" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#808080;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
