        <mxCell id="redis" value="Redis&#10;[KVDB, cashews]&#10;Кэш для Admin UI — MVP (опц.)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
