        <mxCell id="recsys" value="RecSys (PA Api)&#10;[MS: Go]&#10;MVP — пушит данные" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="60" width="220" height="80" as="geometry" />
